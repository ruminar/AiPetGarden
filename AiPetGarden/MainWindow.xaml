<Window x:Class="AiPetGarden.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="AI Pet Garden" Height="560" Width="900" MinHeight="400" MinWidth="650">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <DockPanel Grid.Row="0" LastChildFill="False">
            <Button Content="再読込" Padding="18,6" Click="ReloadButton_Click" />
            <Button Content="選択したペットを表示" Margin="8,0,0,0" Padding="18,6" Click="ShowPetButton_Click" />
            <Button Content="起こす" Margin="8,0,0,0" Padding="12,6" Click="WakePetButton_Click" />
            <Button Content="寝かせる" Margin="8,0,0,0" Padding="12,6" Click="SleepPetButton_Click" />
            <Button Content="非表示" Margin="8,0,0,0" Padding="12,6" Click="HidePetButton_Click" />
            <Button Content="設定" Margin="8,0,0,0" Padding="12,6" Click="SettingsButton_Click" />
            <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Text="{Binding StatusText}" />
        </DockPanel>
        <TextBlock Grid.Row="1" Margin="0,16,0,8" TextWrapping="Wrap">
            <Run Text="読取専用のペット資産: " />
            <Run Text="{Binding PetRoot, Mode=OneWay}" />
        </TextBlock>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <GroupBox Header="検出したペット" Margin="0,0,10,0">
                <ListView x:Name="PetList" ItemsSource="{Binding Pets}" BorderThickness="0"
                          MouseDoubleClick="PetList_MouseDoubleClick">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="名前" Width="190" DisplayMemberBinding="{Binding DisplayName}" />
                            <GridViewColumn Header="Asset ID" Width="170" DisplayMemberBinding="{Binding AssetId}" />
                            <GridViewColumn Header="画像数" Width="70" DisplayMemberBinding="{Binding SpriteCount}" />
                            <GridViewColumn Header="状態" Width="90" DisplayMemberBinding="{Binding DisplayStatus}" />
                            <GridViewColumn Header="metadata" Width="330" DisplayMemberBinding="{Binding MetadataPath}" />
                        </GridView>
                    </ListView.View>
                </ListView>
            </GroupBox>
            <GroupBox Grid.Column="1" Header="読込上の問題">
                <ListBox ItemsSource="{Binding Issues}" BorderThickness="0" />
            </GroupBox>
        </Grid>
        <TextBlock Grid.Row="3" Margin="0,12,0,0" Foreground="DimGray"
                   Text="Codexのペット資産は読取専用です。位置と設定はLocalAppDataへ保存します。" />
    </Grid>
</Window>
